# =====================================================================
# DSS Klinik Bersalin — contoh env
# Salin jadi .env lalu isi nilainya: cp .env.example .env
# =====================================================================

# ---------- Docker / PostgreSQL (dibaca oleh compose.yaml) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dss_klinik
POSTGRES_PORT=5432

# ---------- Aplikasi (FastAPI) ----------
# Port HTTP yang diekspos ke host oleh service `api` di Compose
API_PORT=8000

# ---------- Aplikasi (FastAPI) ----------
# Untuk FastAPI di host: localhost. (Di dalam compose, nanti dipakai `db`, bukan localhost.)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dss_klinik
APP_ENV=dev
DB_ECHO=false

# ---------- Keamanan / JWT ----------
# Tanpa refresh token; JWT 1 jam (kontrak expires_in 3600).
# WAJIB diganti sebelum APP_ENV=prod (startup menolak nilai bawaan saat prod).
JWT_SECRET=dev-secret-ganti-di-env
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- CORS (frontend Vue) ----------
# Origin FE yang diizinkan. Beda port = beda origin, jadi localhost & 127.0.0.1 dipisah.
# Origin cloudflared tunnel untuk demo jarak jauh juga didaftar di sini.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bidan.delta-zero.my.id

# ---------- Keputusan sementara: endpoint admin bisa dipakai oleh bidan ----------
ADMIN_ENDPOINTS_ALLOW_BIDAN=true

# ---------- Seed akun default bidan (CLI seed-bidan) ----------
SEED_BIDAN_USERNAME=bidan1
SEED_BIDAN_PASSWORD=bidan12345
SEED_BIDAN_NAMA_LENGKAP=Bidan Default
